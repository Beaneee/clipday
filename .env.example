EXPO_PUBLIC_API_URL=http://localhost:3000
# Hugging Face 무료 토큰 → https://huggingface.co/settings/tokens
EXPO_PUBLIC_HF_API_KEY=your_hf_token_here
# 공공데이터포털 "한국천문연구원 특일 정보" 서비스키(Decoding 키) → https://www.data.go.kr/data/15012690/openapi.do
# 없으면 검증된 오프라인 표로 자동 폴백됩니다.
EXPO_PUBLIC_KDATA_SERVICE_KEY=your_data_go_kr_decoding_key_here
